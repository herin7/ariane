# Copy to .env.local. Nothing here is required to run the compiler or the web
# app, because the graph is seeded from disk and every fallback is deterministic.
# Each block below turns on one thing and nothing else.

# --- Supabase. Where the government facts live. ---
# Schemes, documents, offices, fees, eligibility rules and the quotes behind
# them are rows, so a moved office is an edit rather than a deploy.
#
# Until these are set, loadLiveGraph() serves the checked in seed at
# packages/core/src/data/graph, which is the same data and always works.
# The anon key is enough to read. The service role key is only for db:push.
#
#   psql "$SUPABASE_DB_URL" -f packages/core/src/db/schema.sql
#   pnpm db:push
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AWS Bedrock. Plain language to candidate service, nothing more. ---
# Without these, intent resolution falls back to token overlap, which is honest
# but dumb. The model is never allowed to invent a service either way.
#
# One bearer token is the whole configuration. Everything below it has a
# default that works. To see what your account can actually call:
#
#   curl -H "authorization: Bearer $AWS_BEARER_TOKEN_BEDROCK" \
#        -H "openai-project: default" \
#        https://bedrock-mantle.us-east-1.api.aws/v1/models
#
# Note the route. Non Anthropic models are served at /v1/chat/completions with
# an openai-project header. /anthropic/v1/messages is Claude only and will 400
# on everything else, which is not obvious from the error it returns.
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL_ID=moonshotai.kimi-k2.5
BEDROCK_PROJECT=default

# --- Sarvam. Indian language input and output. ---
SARVAM_API_KEY=

# --- Azure Foundry, GPT Realtime. Voice, last thing to land. ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_REALTIME_DEPLOYMENT=

# --- Firecrawl. Only needed to refresh docs/research, never at runtime. ---
FIRECRAWL_API_KEY=
