# Copy to .env at the repository root. One file, not one per app: the web app
# loads it in next.config.ts and the CLIs in packages/core read the same
# credentials.
#
# Nothing here is required to run the compiler, the tests or the web app: the
# graph is seeded from disk and every fallback is deterministic. Each block
# turns on one capability and nothing else.

# ============================================================ Database
# Where the government facts live. Schemes, documents, offices, fees, eligibility
# rules and the quotes behind them are rows, so a moved office is an edit rather
# than a deploy.
#
# The rows are not in this repository. Until these are set, a clone runs on
# fixtures/demo, which is one invented tree felling permit and is never served
# to a citizen: in production, a process with no real graph refuses rather than
# answering from four synthetic nodes.
#
# The anon key is enough to read. The service role key is only for db:push and
# data:sync.
#
#   psql "$SUPABASE_DB_URL" -f packages/core/src/db/schema.sql
#   pnpm data:sync    # database -> .graph/, for gates:integration
#   pnpm db:push      # .graph/  -> database
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Where the real graph sits on this machine, if not .graph/ in the repository
# root. Read by data:sync, by the CLIs, and by the tests that assert real
# Gujarat facts. Gitignored either way.
ARIANE_GRAPH_DIR=

# ============================================================== Models
# Plain language to a candidate service, and nothing more. Without these, intent
# resolution falls back to token overlap, which is honest but blunt. The model is
# never allowed to invent a service either way.
#
# One bearer token is the whole configuration; everything below it has a working
# default. To see what an account can actually call:
#
#   curl -H "authorization: Bearer $AWS_BEARER_TOKEN_BEDROCK" \
#        -H "openai-project: default" \
#        https://bedrock-mantle.us-east-1.api.aws/v1/models
#
# Note the route. Non-Anthropic models are served at /v1/chat/completions with an
# openai-project header. /anthropic/v1/messages is Claude-only and returns a 400
# on everything else, which the error text does not make obvious.
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL_ID=moonshotai.kimi-k2.5
BEDROCK_PROJECT=default

# ============================================================ Language
# Indian language input and output. Without it, non-Latin script input is passed
# through unchanged and only the alias index can match it.
SARVAM_API_KEY=

# ============================================================ Crawling
# Only needed to fetch new government pages. Never read at runtime, and never
# needed to build, test or serve anything in this repository.
FIRECRAWL_API_KEY=

# Where a local evidence corpus lives, if you have one. The public repository
# ships neither the page bodies nor the graph read off them, so the corpus gates
# are opt-in. See NOTICE.
#   pnpm gates:corpus
ARIANE_CORPUS_DIR=

# =============================================================== Voice
# The voice agent. Every /api/voice route answers 503 until the two secrets
# below exist, which is the whole switch: no flag, no deploy config, just keys
# a deployment either has or does not.
#
# Generate each one separately and never reuse them elsewhere:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# VOICE_SESSION_SECRET keys the session tokens handed to a browser.
# VOICE_PHONE_HMAC_SECRET keys the caller-id hash. Phone numbers are never
# stored; this is what turns one into a row key. Rotating it makes every
# returning caller a stranger, which is a recovery path, not a disaster.
#
# Outside production, a missing secret becomes a random per-process value with a
# warning, so `pnpm dev` works and sessions simply do not survive a restart. In
# production a missing secret disables voice rather than inventing one.
#
# Voice keeps its own five tables. If SUPABASE_URL is set, apply them once:
#   psql "$SUPABASE_DB_URL" -f packages/voice/src/db/voice-schema.sql
VOICE_SESSION_SECRET=
VOICE_PHONE_HMAC_SECRET=

# The realtime model, served by Azure AI Foundry. Speech to speech, so one key
# rather than an STT, an LLM and a TTS. The key never reaches the browser: the
# server mints a client secret that expires in about a minute and covers one
# WebRTC handshake.
#
# ENDPOINT is the resource root and nothing more - no path, no api-version:
#   https://<your-resource>.openai.azure.com
# Realtime is a global deployment in East US 2 or Sweden Central only.
#
# DEPLOYMENT is the name you gave the deployment in the Foundry portal, which
# is not necessarily the name of the model inside it. Get it wrong and the mint
# fails with a 404 that does not say the word "deployment".
#
# VOICE: alloy, ash, ballad, coral, echo, marin, sage, shimmer or verse.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime
AZURE_OPENAI_REALTIME_VOICE=marin

# Telephony, optional. Without it the browser leg works and /api/voice/vapi/
# webhook answers 503. The secret is what the webhook signature is checked
# against; there is no unauthenticated path to that route. Nothing here dials
# out, so Vapi's own API key belongs in Vapi's dashboard rather than in here.
VAPI_WEBHOOK_SECRET=

# Off by default, all three, and each one is a decision rather than a toggle.
#   TRANSCRIBE=1  writes the caller's words down. The model hears them either
#                 way; this is what puts them in a logging pipeline.
#   QUIET=1       silences the structured event sink.
#   STUB_STEPUP=1 a deterministic OTP provider for local demos. Refuses to run
#                 when NODE_ENV is production.
ARIANE_VOICE_TRANSCRIBE=
ARIANE_VOICE_QUIET=
ARIANE_VOICE_STUB_STEPUP=

# Tracing, optional and off unless all three are set. Payloads are masked before
# they leave the process: no phone number, no transcript, no memory contents.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# ================================================== Sign-in and limits
# Ariane's own two tiers. Without a Supabase project below, the whole site works
# and voice is guest only: one minute, once a day, per browser and per address.
# Non-voice pages never ask anybody to sign in.
#
# These are the publishable half of the same project as SUPABASE_URL above. They
# reach the browser by design and they are meant to - a publishable key can only
# do what row level security lets it, and every telemetry table has RLS on with
# no policies, so this key cannot see one row of any of them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Keys the ip hashes and the guest cookie. Nothing stores a raw address; this is
# what turns one into a column. Rotating it resets every guest quota, which is a
# recovery path rather than a disaster.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=

# The rate limits, the ten concurrent lines and the queue keep their own tables.
# Apply them once, alongside the voice schema:
#   psql "$SUPABASE_DB_URL" -f packages/voice/src/db/ops-schema.sql

# =============================================================== Admin
# /admin, /admin/users, /admin/conversations, /admin/security, /admin/traffic
# and /admin/voice. Until all three exist, every one of them refuses.
#
# /admin/graph and /admin/coverage are public pages and are not affected.
#
# Never put a plaintext password in this file, in .env, or in Git. Generate the
# hash and a session secret, paste them into your deployment's environment, and
# keep the password in a password manager:
#   node apps/web/scripts/admin-hash.mjs
#
# ADMIN_PASSWORD_HASH is scrypt: `scrypt$N$r$p$salt$hash`, base64url.
# ADMIN_SESSION_SECRET signs the admin cookie. Rotating it signs everybody out.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Set to 1 only behind a proxy you control that overwrites x-forwarded-for.
# On Vercel this is unnecessary: x-vercel-forwarded-for is already trustworthy,
# and honouring an arbitrary forwarded header lets anybody pick their own
# identity for every rate limit in the deployment.
ARIANE_TRUST_FORWARDED=

# Deleting expired rows. Any scheduler that can make an authenticated request
# will do; Vercel Cron is configured in apps/web/vercel.json and needs this
# secret to match. Without it /api/cron/cleanup refuses.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Where the mobile app should look for the API when it is not the machine that
# served the bundle. Expo resolves the dev machine automatically otherwise.
EXPO_PUBLIC_API_URL=
