# Copy to .env.local. Nothing here is required to run the compiler, the tests or
# the web app: the graph is seeded from disk and every fallback is deterministic.
# Each block turns on one capability and nothing else.

# ============================================================ Database
# Where the government facts live. Schemes, documents, offices, fees, eligibility
# rules and the quotes behind them are rows, so a moved office is an edit rather
# than a deploy.
#
# Until these are set, loadLiveGraph() serves the checked-in seed at
# packages/core/src/data/graph, which is the same data and always works.
# The anon key is enough to read. The service role key is only for db:push.
#
#   psql "$SUPABASE_DB_URL" -f packages/core/src/db/schema.sql
#   pnpm db:push
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================== Models
# Plain language to a candidate service, and nothing more. Without these, intent
# resolution falls back to token overlap, which is honest but blunt. The model is
# never allowed to invent a service either way.
#
# One bearer token is the whole configuration; everything below it has a working
# default. To see what an account can actually call:
#
#   curl -H "authorization: Bearer $AWS_BEARER_TOKEN_BEDROCK" \
#        -H "openai-project: default" \
#        https://bedrock-mantle.us-east-1.api.aws/v1/models
#
# Note the route. Non-Anthropic models are served at /v1/chat/completions with an
# openai-project header. /anthropic/v1/messages is Claude-only and returns a 400
# on everything else, which the error text does not make obvious.
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODEL_ID=moonshotai.kimi-k2.5
BEDROCK_PROJECT=default

# ============================================================ Language
# Indian language input and output. Without it, non-Latin script input is passed
# through unchanged and only the alias index can match it.
SARVAM_API_KEY=

# ============================================================ Crawling
# Only needed to fetch new government pages. Never read at runtime, and never
# needed to build, test or serve anything in this repository.
FIRECRAWL_API_KEY=

# Where a local evidence corpus lives, if you have one. The public repository
# ships extracted facts and quotes, not the source page bodies, so the corpus
# gates are opt-in. See NOTICE and CONTRIBUTING.md.
#   pnpm gates:corpus
ARIANE_CORPUS_DIR=

# Where the mobile app should look for the API when it is not the machine that
# served the bundle. Expo resolves the dev machine automatically otherwise.
EXPO_PUBLIC_API_URL=
