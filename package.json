{
  "name": "ariane",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @ariane/web dev",
    "mobile": "pnpm --filter @ariane/mobile start",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "graph:stats": "pnpm --filter @ariane/core graph:stats",
    "graph:validate": "pnpm --filter @ariane/core graph:validate",
    "journey:test": "pnpm --filter @ariane/core journey:test",
    "quotes:audit": "pnpm --filter @ariane/core quotes:audit",
    "coverage": "pnpm --filter @ariane/core coverage",
    "db:push": "pnpm --filter @ariane/core db:push",
    "verify:live": "node scripts/verify-live.mjs",
    "domains:build": "node scripts/domains.mjs",
    "domains:classify": "node --env-file-if-exists=.env scripts/ingest/domains-classify.mjs",
    "ingest:selftest": "node scripts/ingest/lib.mjs",
    "pdf:extract": "node --env-file-if-exists=.env scripts/ingest/pdf-extract.mjs",
    "offices:discover": "node --env-file-if-exists=.env scripts/ingest/offices-discover.mjs",
    "fetch:ledger": "node scripts/fetch-ledger.mjs",
    "fetch:have": "node scripts/fetch-ledger.mjs --have",
    "graph:snapshot": "pnpm --filter @ariane/core graph:snapshot",
    "bundles:build": "node scripts/bundles.mjs",
    "gates": "node scripts/ingest/lib.mjs && node scripts/ingest/domains-classify.mjs --selftest && node scripts/ingest/services-discover.mjs --selftest && node scripts/ingest/services-extract.mjs --selftest && node scripts/ingest/services-compile.mjs --selftest && node scripts/ingest/pdf-extract.mjs --selftest && node scripts/ingest/offices-discover.mjs --selftest && node scripts/ingest/rejections-stats.mjs --selftest && node scripts/ingest/chunks.mjs --selftest && node scripts/bundles.mjs --check && node scripts/domains.mjs --check && node scripts/fetch-ledger.mjs --check && pnpm typecheck && pnpm test && pnpm graph:validate && pnpm quotes:audit && pnpm coverage --check",
    "services:discover": "node --env-file-if-exists=.env scripts/ingest/services-discover.mjs",
    "services:extract": "node --env-file-if-exists=.env scripts/ingest/services-extract.mjs",
    "services:compile": "node --env-file-if-exists=.env scripts/ingest/services-compile.mjs",
    "rejections:stats": "node scripts/ingest/rejections-stats.mjs",
    "corpus:chunk": "node scripts/ingest/chunks.mjs",
    "intent:eval": "pnpm --filter @ariane/core intent:eval"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "unpdf": "^1.8.1"
  }
}
