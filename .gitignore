# ---------------------------------------------------------------- private work
# Internal planning, milestone logs and scratch notes. None of this belongs in
# a public repository, and none of it is needed to build or run Ariane.
plan.md
log.md
version.md
context.md
NOTES.md
SCRATCH.md
TODO.md
docs/BUILD_PLAN.md
docs/GOAL.md
*.notes.md
*.plan.md
.claude/

# ------------------------------------------------------------- evidence corpus
# The raw pages, PDFs and model-response caches the ingestion pipeline builds.
# This repository ships the extracted facts and their verbatim quotes, not the
# source bodies they were quoted from: those are third-party government content
# and are not ours to redistribute. See NOTICE.
#
# Point ARIANE_CORPUS_DIR at a local corpus to run `pnpm gates:corpus`.
.ingest/
.firecrawl/
.corpus/
.private/

# --------------------------------------------------------------- build outputs
node_modules/
.pnpm-store/
dist/
build/
out/
.next/
.expo/
*.tsbuildinfo

# ------------------------------------------------------------------ env config
# .env.example is the only environment file that is tracked.
.env
.env.local
.env.*.local
.env.*
!.env.example

# ----------------------------------------------------------------- tooling out
# Anchored. Unanchored, `coverage/` also matched apps/web/app/admin/coverage,
# which silently removed a real application route from every clone.
/coverage/
/*/*/coverage/
.turbo/
.vercel/
*.log
.tmp/
temp/
scratch/

# -------------------------------------------------------------------------- os
.DS_Store
Thumbs.db
