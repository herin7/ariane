# ---------------------------------------------------------------- private work
# Internal planning, milestone logs and scratch notes. None of this belongs in
# a public repository, and none of it is needed to build or run Ariane.
plan.md
log.md
version.md
context.md
NOTES.md
SCRATCH.md
TODO.md
docs/BUILD_PLAN.md
docs/GOAL.md
*.notes.md
*.plan.md
.claude/

# ------------------------------------------------------------- evidence corpus
# The raw pages, PDFs and model-response caches the ingestion pipeline builds.
# This repository ships the extracted facts and their verbatim quotes, not the
# source bodies they were quoted from: those are third-party government content
# and are not ours to redistribute. See NOTICE.
#
# Point ARIANE_CORPUS_DIR at a local corpus to run `pnpm gates:corpus`.
.ingest/
.firecrawl/
.corpus/
.private/

# ---------------------------------------------------------------- graph bundles
# The compiled graph. 7MB of government facts across 18 files, and the database
# is where they live: `loadLiveGraph` reads Supabase, the seed is only a local
# convenience. Checking them in put a 150,000 line diff in front of every
# reviewer and made a data correction look like a code change.
#
# Rehydrate a clone with: pnpm db:pull   (needs SUPABASE_URL + service role key)
#
# jurisdictions.json stays tracked. It is the district list, not a scheme fact,
# it is imported by name in data/index.ts, and it is 4KB.
packages/core/src/data/graph/*.json
!packages/core/src/data/graph/jurisdictions.json
# Generated from the files above, so it cannot outlive them.
packages/core/src/data/graph/manifest.ts

# What the ingestion pipeline hands a human to look at: geocoder near-misses,
# rejected matches, the reasons. Regenerated by the run that produced it and
# stale the moment the data moves, so it is a working note, not a source file.
artifacts/

