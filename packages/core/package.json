{
  "name": "@ariane/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./journey": "./src/journey.ts",
    "./location": "./src/location.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "graph:stats": "tsx src/cli/stats.ts",
    "graph:validate": "tsx src/cli/validate.ts",
    "offices:geocode": "tsx src/cli/geocode.ts",
    "journey:test": "tsx src/cli/journey.ts",
    "quotes:audit": "tsx src/cli/quotes.ts",
    "coverage": "tsx src/cli/coverage.ts",
    "db:push": "tsx --env-file-if-exists=../../.env src/cli/db-push.ts",
    "db:pull": "tsx --env-file-if-exists=../../.env src/cli/db-pull.ts",
    "graph:snapshot": "tsx src/cli/snapshot.ts",
    "intent:eval": "tsx --env-file-if-exists=../../.env src/cli/intent-eval.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
