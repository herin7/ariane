# The opt-in switch for `capacity.pg.test.ts`, and nothing else.
#
# A file rather than an inline `VAR=1 cmd`, because that syntax is a shell
# feature and this repository is developed on Windows. `node --env-file` works
# the same everywhere.
#
# Never put a credential here. This file is committed; `.env` next to it is not,
# and `test:pg` loads that one for the actual Supabase connection.
ARIANE_OPS_PG_TESTS=1
